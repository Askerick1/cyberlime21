{
  "name": "asker111",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/worker-build.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "npx wrangler@4 deploy",
    "migrate": "npx wrangler@4 d1 migrations apply DB --remote",
    "deploy:cloudflare": "npm run migrate && npm run deploy",
    "preview": "npx wrangler@4 dev",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "framer-motion": "^12.6.0",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^6.3.0",
    "typescript": "~5.8.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0"
  }
}
